{
  "name": "sqldoro",
  "displayName": "sqldoro",
  "description": "A fast, safe MySQL and PostgreSQL client: schema explorer, SQL editor with autocomplete, a virtualized result grid, inline editing with an SQL preview, and safety guards for every statement. No telemetry.",
  "version": "0.1.0",
  "publisher": "mathmed",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathmed/sqldoro.git"
  },
  "bugs": {
    "url": "https://github.com/mathmed/sqldoro/issues"
  },
  "homepage": "https://github.com/mathmed/sqldoro#readme",
  "qna": "https://github.com/mathmed/sqldoro/issues",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#16285C",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "database",
    "sql",
    "mysql",
    "postgres",
    "postgresql",
    "database client",
    "sql client",
    "sql editor",
    "query",
    "schema explorer",
    "ssh tunnel",
    "result grid",
    "data editor",
    "read-only",
    "safe"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.2.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sqldoro.hello",
        "title": "Hello",
        "category": "sqldoro"
      },
      {
