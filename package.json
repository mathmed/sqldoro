{
  "name": "sqldoro",
  "displayName": "sqldoro",
  "description": "A fast, safe MySQL and PostgreSQL client for VS Code.",
  "version": "0.0.1",
  "publisher": "mathmed",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathmed/sqldoro.git"
  },
  "bugs": {
    "url": "https://github.com/mathmed/sqldoro/issues"
  },
  "homepage": "https://github.com/mathmed/sqldoro#readme",
  "keywords": [
    "database",
    "mysql",
    "postgres",
    "postgresql",
    "sql"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.2.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "sqldoro.hello",
        "title": "Hello",
        "category": "sqldoro"
      },
      {
        "command": "sqldoro.addConnection",
        "title": "Add Connection",
        "category": "sqldoro",
        "icon": "$(add)"
      },
      {
        "command": "sqldoro.importConnectionUrl",
        "title": "Import Connection from URL",
        "category": "sqldoro",
        "icon": "$(link)"
      },
      {
        "command": "sqldoro.editConnection",
        "title": "Edit Connection",
        "category": "sqldoro",
        "icon": "$(edit)"
      },
      {
        "command": "sqldoro.duplicateConnection",
        "title": "Duplicate Connection",
        "category": "sqldoro",
        "icon": "$(copy)"
      },
      {
        "command": "sqldoro.deleteConnection",
        "title": "Delete Connection",
        "category": "sqldoro",
        "icon": "$(trash)"
      },
      {
        "command": "sqldoro.testConnection",
        "title": "Test Connection",
        "category": "sqldoro",
        "icon": "$(pulse)"
      },
      {
        "command": "sqldoro.connect",
        "title": "Connect",
        "category": "sqldoro",
        "icon": "$(plug)"
      },
      {
        "command": "sqldoro.disconnect",
        "title": "Disconnect",
        "category": "sqldoro",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sqldoro.refresh",
        "title": "Refresh",
        "category": "sqldoro",
        "icon": "$(refresh)"
      },
      {
        "command": "sqldoro.filter",
        "title": "Filter Tables and Views",
        "category": "sqldoro",
        "icon": "$(filter)"
      },
      {
        "command": "sqldoro.clearFilter",
        "title": "Clear Filter",
        "category": "sqldoro",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqldoro",
          "title": "sqldoro",
          "icon": "media/sqldoro.svg"
        }
      ]
    },
    "views": {
      "sqldoro": [
        {
          "id": "sqldoro.connections",
          "name": "Connections",
          "icon": "media/sqldoro.svg",
          "contextualTitle": "sqldoro"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqldoro.connections",
        "contents": "No database connections yet.\n[Add Connection](command:sqldoro.addConnection)\n[Import from URL](command:sqldoro.importConnectionUrl)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sqldoro.addConnection",
          "when": "view == sqldoro.connections",
          "group": "navigation@1"
        },
        {
          "command": "sqldoro.filter",
          "when": "view == sqldoro.connections",
          "group": "navigation@2"
        },
        {
          "command": "sqldoro.clearFilter",
          "when": "view == sqldoro.connections && sqldoro.isFiltered",
          "group": "navigation@3"
        },
        {
          "command": "sqldoro.refresh",
          "when": "view == sqldoro.connections",
          "group": "navigation@4"
        },
        {
          "command": "sqldoro.importConnectionUrl",
          "when": "view == sqldoro.connections",
          "group": "1_connections@1"
        }
      ],
      "view/item/context": [
        {
          "command": "sqldoro.connect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(disconnected|failed)$/",
          "group": "inline@1"
        },
        {
          "command": "sqldoro.disconnect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(connected|connecting)$/",
          "group": "inline@1"
        },
        {
          "command": "sqldoro.connect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(disconnected|failed)$/",
          "group": "1_session@1"
        },
        {
          "command": "sqldoro.disconnect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(connected|connecting)$/",
          "group": "1_session@1"
        },
        {
          "command": "sqldoro.testConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "1_session@2"
        },
        {
          "command": "sqldoro.editConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "2_edit@1"
        },
        {
          "command": "sqldoro.duplicateConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "2_edit@2"
        },
        {
          "command": "sqldoro.deleteConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "3_delete@1"
        },
        {
          "command": "sqldoro.refresh",
          "when": "view == sqldoro.connections && viewItem =~ /^(connection\\.connected|database|schema|tables|views|table|view|columns|indexes|foreignKeys)$/",
          "group": "4_refresh@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sqldoro.clearFilter",
          "when": "sqldoro.isFiltered"
        }
      ]
    }
  },
  "scripts": {
    "hooks": "lefthook install",
    "build": "node scripts/build.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint:arch": "depcruise src scripts test",
    "dead-code": "knip --treat-config-hints-as-errors",
    "smoke": "node scripts/smoke.ts",
    "mutation": "node scripts/mutation.ts full",
    "mutation:changed": "node scripts/mutation.ts changed"
  },
  "dependencies": {
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/eslint-plugin-no-unsanitized": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "1.140.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/test-electron": "^3.1.0",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jiti": "^2.7.0",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
