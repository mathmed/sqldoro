      "view/item/context": [
        {
          "command": "sqldoro.connect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(disconnected|failed)\\./",
          "group": "inline@1"
        },
        {
          "command": "sqldoro.disconnect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(connected|connecting)\\./",
          "group": "inline@1"
        },
        {
          "command": "sqldoro.connect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(disconnected|failed)\\./",
          "group": "1_session@1"
        },
        {
          "command": "sqldoro.disconnect",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.(connected|connecting)\\./",
          "group": "1_session@1"
        },
        {
          "command": "sqldoro.testConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "1_session@2"
        },
        {
          "command": "sqldoro.editConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "2_edit@1"
        },
        {
          "command": "sqldoro.duplicateConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "2_edit@2"
        },
        {
          "command": "sqldoro.allowWrites",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.[a-z]+\\.readOnly$/",
          "group": "2_edit@3"
        },
        {
          "command": "sqldoro.makeReadOnly",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\.[a-z]+\\.writable$/",
          "group": "2_edit@3"
        },
        {
          "command": "sqldoro.moveToFolder",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "2_edit@4"
        },
        {
          "command": "sqldoro.deleteConnection",
          "when": "view == sqldoro.connections && viewItem =~ /^connection\\./",
          "group": "3_delete@1"
        },
        {
          "command": "sqldoro.renameFolder",
          "when": "view == sqldoro.connections && viewItem == folder",
          "group": "1_folder@1"
        },
        {
          "command": "sqldoro.deleteFolder",
          "when": "view == sqldoro.connections && viewItem == folder",
          "group": "2_delete@1"
        },
        {
          "command": "sqldoro.refresh",
          "when": "view == sqldoro.connections && viewItem =~ /^(connection\\.connected\\.[a-zA-Z]+|database|schema|tables|views|table|view|columns|indexes|foreignKeys)$/",
          "group": "4_refresh@1"
        },
        {
          "command": "sqldoro.newQuery",
          "when": "view == sqldoro.connections && viewItem =~ /^(database|schema)$/",
          "group": "inline@1"
        },
        {
          "command": "sqldoro.refresh",
          "when": "view == sqldoro.connections && viewItem =~ /^(database|schema)$/",
          "group": "inline@2"
        },
        {
          "command": "sqldoro.newQuery",
          "when": "view == sqldoro.connections && viewItem =~ /^(connection\\..*|database|schema)$/",
          "group": "0_query@1"
        },
        {
          "command": "sqldoro.openTableData",
          "when": "view == sqldoro.connections && viewItem =~ /^(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "sqldoro.openTableData",
          "when": "view == sqldoro.connections && viewItem =~ /^(table|view)$/",
          "group": "0_query@1"
        },
        {
          "command": "sqldoro.showDdl",
          "when": "view == sqldoro.connections && viewItem =~ /^(table|view)$/",
          "group": "0_query@2"
        },
        {
          "command": "sqldoro.openHistoryEntry",
