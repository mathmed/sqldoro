          "group": "1_query@1"
        },
        {
          "command": "sqldoro.insertSavedQuery",
          "when": "view == sqldoro.savedQueries && viewItem == savedQuery",
          "group": "1_query@2"
        },
        {
          "command": "sqldoro.renameSavedQuery",
          "when": "view == sqldoro.savedQueries && viewItem == savedQuery",
          "group": "2_edit@1"
        },
        {
          "command": "sqldoro.moveSavedQuery",
          "when": "view == sqldoro.savedQueries && viewItem == savedQuery",
          "group": "2_edit@2"
        },
        {
          "command": "sqldoro.deleteSavedQuery",
          "when": "view == sqldoro.savedQueries && viewItem == savedQuery",
          "group": "3_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sqldoro.clearFilter",
          "when": "sqldoro.isFiltered"
        },
        {
          "command": "sqldoro.showDdl",
          "when": "false"
        },
        {
          "command": "sqldoro.openTableData",
          "when": "false"
        },
        {
          "command": "sqldoro.runQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldoro.runScript",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldoro.cancelQuery",
          "when": "sqldoro.isQueryRunning"
        },
        {
          "command": "sqldoro.explain",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldoro.explainAnalyze",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldoro.changeConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldoro.showResults",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldoro.toggleTransactionMode",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldoro.commitTransaction",
          "when": "sqldoro.hasOpenTransaction"
        },
        {
          "command": "sqldoro.rollbackTransaction",
          "when": "sqldoro.hasOpenTransaction"
        }
      ],
      "editor/title": [
        {
          "command": "sqldoro.runQuery",
          "when": "editorLangId == sql && !sqldoro.isQueryRunning",
          "group": "navigation@1"
        },
        {
          "command": "sqldoro.cancelQuery",
          "when": "editorLangId == sql && sqldoro.isQueryRunning",
          "group": "navigation@1"
        },
        {
          "command": "sqldoro.changeConnection",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "sqldoro.commitTransaction",
          "when": "editorLangId == sql && sqldoro.hasOpenTransaction",
          "group": "navigation@3"
        },
        {
          "command": "sqldoro.rollbackTransaction",
          "when": "editorLangId == sql && sqldoro.hasOpenTransaction",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "sqldoro.runQuery",
          "when": "editorLangId == sql",
          "group": "sqldoro@1"
        },
        {
          "command": "sqldoro.runScript",
          "when": "editorLangId == sql",
          "group": "sqldoro@2"
        },
        {
          "command": "sqldoro.explain",
          "when": "editorLangId == sql",
          "group": "sqldoro@3"
        },
        {
          "command": "sqldoro.explainAnalyze",
          "when": "editorLangId == sql",
          "group": "sqldoro@4"
        },
        {
          "command": "sqldoro.saveQuery",
          "when": "editorLangId == sql",
          "group": "sqldoro@5"
        },
        {
          "command": "sqldoro.changeConnection",
          "when": "editorLangId == sql",
          "group": "sqldoro@6"
        },
        {
          "command": "sqldoro.toggleTransactionMode",
          "when": "editorLangId == sql",
          "group": "sqldoro@7"
        },
        {
          "command": "sqldoro.commitTransaction",
          "when": "editorLangId == sql && sqldoro.hasOpenTransaction",
          "group": "sqldoro@8"
        },
        {
          "command": "sqldoro.rollbackTransaction",
          "when": "editorLangId == sql && sqldoro.hasOpenTransaction",
          "group": "sqldoro@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sqldoro.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && sqldoro.editorHasConnection"
      },
      {
        "command": "sqldoro.runScript",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == sql && sqldoro.editorHasConnection"
      },
      {
        "command": "sqldoro.cancelQuery",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "editorTextFocus && editorLangId == sql && sqldoro.isQueryRunning"
      },
      {
        "command": "sqldoro.goToTable",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "configuration": {
      "title": "sqldoro",
      "properties": {
        "sqldoro.results.maxRows": {
          "type": "integer",
          "default": 100000,
          "minimum": 1,
          "maximum": 5000000,
          "markdownDescription": "The most rows sqldoro keeps of a result; past it the result is flagged as cut. The grid shows a million rows smoothly; every row kept uses memory of the extension host."
        },
        "sqldoro.history.maxEntriesPerConnection": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "markdownDescription": "The most statements the query history keeps per connection; the oldest go first."
        },
        "sqldoro.autoLimit.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Give a query that reads and has no `LIMIT`, `FETCH` or `TOP` of its own an automatic limit of `#sqldoro.autoLimit.rows#` rows. The result says when the limit cut it and offers **Load All Rows**."
        },
        "sqldoro.autoLimit.rows": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "maximum": 5000000,
          "markdownDescription": "The rows the automatic limit keeps, never more than `#sqldoro.results.maxRows#`."
        },
        "sqldoro.safety.productionEnvironments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "local",
              "dev",
              "staging",
              "prod"
            ]
          },
          "uniqueItems": true,
          "default": [
            "prod"
          ],
          "markdownDescription": "The environment tags treated as production: every statement that writes there asks you to type the name of the connection, a connection given one of these tags becomes read-only, and editors show it in red. `prod` always counts: this list can only add to it."
        },
        "sqldoro.transactions.defaultMode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "enumDescriptions": [
            "Each statement commits as it runs.",
            "The first statement opens a transaction that stays open until you commit or roll it back."
          ],
          "default": "auto",
          "markdownDescription": "The transaction mode new SQL editors start in; **Switch Transaction Mode** changes it per editor."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "sqldoro.gettingStarted",
        "title": "Get Started with sqldoro",
        "description": "Connect to MySQL or PostgreSQL, run your first query, and see how sqldoro keeps the dangerous statements hard.",
        "steps": [
          {
            "id": "connect",
            "title": "Add a connection",
            "description": "Connect to MySQL or PostgreSQL, directly or through an SSH tunnel. Passwords stay in the VS Code secret storage, and new connections are read-only.\n[Add Connection](command:sqldoro.addConnection)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:sqldoro.addConnection",
              "onCommand:sqldoro.importConnectionUrl"
            ]
          },
          {
            "id": "query",
            "title": "Run a query",
            "description": "Open a SQL editor on a connection, run the statement under the cursor with Ctrl+Enter (Cmd+Enter on macOS) and browse the results in the grid.\n[New Query](command:sqldoro.newQuery)",
            "media": {
              "markdown": "media/walkthrough/query.md"
            },
            "completionEvents": [
              "onCommand:sqldoro.runQuery",
              "onCommand:sqldoro.runScript"
            ]
          },
          {
            "id": "safety",
            "title": "Know the safety model",
            "description": "Read-only connections, confirmations for UPDATE and DELETE without WHERE and for production, manual transactions and an automatic LIMIT: what each guard does, and what it cannot do.\n[About the Safety Model](command:sqldoro.about)",
            "media": {
              "markdown": "media/walkthrough/safety.md"
            },
            "completionEvents": [
              "onCommand:sqldoro.about"
            ]
          },
          {
            "id": "edit",
            "title": "Edit rows with a preview",
            "description": "Change the rows of a table in the grid, then preview the exact SQL before anything is written. Allow writes on the connection first.\n[Allow Writes](command:sqldoro.allowWrites)",
            "media": {
              "markdown": "media/walkthrough/edit.md"
            },
            "completionEvents": [
              "onCommand:sqldoro.allowWrites"
            ]
          },
          {
            "id": "keep",
            "title": "Keep your queries",
            "description": "Every statement you run lands in the query history; name the ones you need again in Saved Queries.\n[Search Query History](command:sqldoro.searchHistory)",
            "media": {
              "markdown": "media/walkthrough/keep.md"
            },
            "completionEvents": [
              "onCommand:sqldoro.searchHistory",
              "onCommand:sqldoro.saveQuery"
            ]
          }
        ]
      }
    ]
  },
